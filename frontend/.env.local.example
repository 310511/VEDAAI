# MongoDB (local Docker or Atlas)
MONGODB_URI=mongodb://localhost:27017/vedaai

# Gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-1.5-flash

# Upstash QStash (recommended for reliable background job processing)
# Get token from https://console.upstash.com/qstash
QSTASH_TOKEN=your_qstash_token

# App URL (required for QStash in production)
# Production: Set to your Vercel URL (e.g., https://your-app.vercel.app)
# Local dev: Leave unset (QStash will be skipped, generation runs synchronously)
# Local dev with tunnel: Set to tunnel URL (e.g., https://your-name.ngrok.io)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Vercel background generation (fallback if QStash not configured)
INTERNAL_API_SECRET=generate_a_long_random_string

# Optional: separate Express API instead of Next.js routes
# NEXT_PUBLIC_API_URL=http://localhost:4000
